<Window x:Class="View.usuariosForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View"
        mc:Ignorable="d"
        Title="Usuarios" MinHeight="470" MinWidth="800" SizeToContent="WidthAndHeight">
    <Grid Background="#FFF9F7F2">
        <Label x:Name="label_tituloPagina" Content="Usuarios" HorizontalAlignment="Left" Margin="450,20,0,0" VerticalAlignment="Top" Height="40" Width="84" FontSize="20"/>
        <Rectangle x:Name="menu_lateral" HorizontalAlignment="Left" Height="414" Margin="10,0,0,0" VerticalAlignment="Center" Width="176" RadiusX="10" RadiusY="10" Fill="White">
            <Rectangle.Effect>
                <DropShadowEffect Color="#80000000" BlurRadius="12" ShadowDepth="0" Opacity="0.65"/>
            </Rectangle.Effect>
        </Rectangle>
        <Image x:Name="titulo" HorizontalAlignment="Left" Height="189" Margin="16,-43,0,0" VerticalAlignment="Top" Width="164" Source="/titulo.png"/>

        <StackPanel x:Name="stackpanel_menu" Orientation="Vertical" HorizontalAlignment="Left" Margin="31,82,0,0" VerticalAlignment="Top" Width="135">
            <Border x:Name="border_reservas" CornerRadius="8" Background="#FFFF6B6B" Height="36" Margin="0,0,0,8">
                <Button x:Name="button_reservas" Content="Reservas" Background="Transparent" BorderThickness="0" Foreground="White" Click="button_reservas_Click"/>
            </Border>
            <Border x:Name="border_artistas" CornerRadius="8" Background="#FFFF6B6B" Height="36" Margin="0,0,0,8">
                <Button x:Name="button_artistas" Content="Artistas" Background="Transparent" BorderThickness="0" Foreground="White" Click="button_artistas_Click"/>
            </Border>
            <Border x:Name="border_generos" CornerRadius="8" Background="#FFFF6B6B" Height="36" Margin="0,0,0,8">
                <Button x:Name="button_generos" Content="Géneros" Background="Transparent" BorderThickness="0" Foreground="White" Click="button_generos_Click"/>
            </Border>
            <Border x:Name="border_vinilos" CornerRadius="8" Background="#FFFF6B6B" Height="36" Margin="0,0,0,8">
                <Button x:Name="button_vinilos" Content="Vinilos" Background="Transparent" BorderThickness="0" Foreground="White" Click="button_vinilos_Click"/>
            </Border>
        </StackPanel>
        <Border x:Name="border_guardar" CornerRadius="8" Background="#FF7FD05B" Margin="224,388,441,10">
            <Button x:Name="button_guardar" Content="Guardar Usuario" Background="Transparent" BorderThickness="0" Foreground="White"/>
        </Border>
        <Border x:Name="border_cancelar" CornerRadius="8" Background="#FFFF6B6B" Margin="627,388,38,10">
            <Button x:Name="button_cancelar" Content="Cancelar" Background="Transparent" BorderThickness="0" Foreground="White" Click="button_cancelar_Click"/>
        </Border>
        <Label x:Name="label_nombre" Content="Nombre" HorizontalAlignment="Left" Margin="224,82,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="textbox_nombre" HorizontalAlignment="Left" Margin="224,108,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="310" Height="29"/>
        <Label x:Name="label_email" Content="Email" HorizontalAlignment="Left" Margin="224,144,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="textbox_email" HorizontalAlignment="Left" Margin="224,170,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="310" Height="29"/>
        <Label x:Name="label_telefono" Content="Telefono" HorizontalAlignment="Left" Margin="224,0,0,0" VerticalAlignment="Center"/>
        <TextBox x:Name="textbox_telefono" HorizontalAlignment="Left" Margin="224,241,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="310" Height="29"/>

    </Grid>
</Window>
