<Window x:Class="View.VinilosForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View"
        mc:Ignorable="d"
        Title="Vinilos" MinHeight="470" MinWidth="800" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterScreen">
    <Grid Background="#FFF9F7F2">
        <Label x:Name="label_tituloPagina" Content="Vinilos" HorizontalAlignment="Left" Margin="450,20,0,0" VerticalAlignment="Top" Height="40" Width="84" FontSize="20"/>
        <Rectangle x:Name="menu_lateral" HorizontalAlignment="Left" Height="414" Margin="10,0,0,0" VerticalAlignment="Center" Width="176" RadiusX="10" RadiusY="10" Fill="White">
            <Rectangle.Effect>
                <DropShadowEffect Color="#80000000" BlurRadius="12" ShadowDepth="0" Opacity="0.65"/>
            </Rectangle.Effect>
        </Rectangle>
        <Image x:Name="titulo" HorizontalAlignment="Left" Height="189" Margin="16,-43,0,0" VerticalAlignment="Top" Width="164" Source="/titulo.png"/>

        <StackPanel x:Name="stackpanel_menu" Orientation="Vertical" HorizontalAlignment="Left" Margin="31,82,0,0" VerticalAlignment="Top" Width="135">
            <Border x:Name="border_reservas" CornerRadius="8" Background="#FFFF6B6B" Height="36" Margin="0,0,0,8">
                <Button x:Name="button_reservas" Content="Reservas" Background="Transparent" BorderThickness="0" Foreground="White" Click="button_reservas_Click"/>
            </Border>
            <Border x:Name="border_artistas" CornerRadius="8" Background="#FFFF6B6B" Height="36" Margin="0,0,0,8">
                <Button x:Name="button_artistas" Content="Artistas" Background="Transparent" BorderThickness="0" Foreground="White" Click="button_artistas_Click"/>
            </Border>
            <Border x:Name="border_generos" CornerRadius="8" Background="#FFFF6B6B" Height="36" Margin="0,0,0,8">
                <Button x:Name="button_generos" Content="Géneros" Background="Transparent" BorderThickness="0" Foreground="White" Height="36" VerticalAlignment="Top" Click="button_generos_Click"/>
            </Border>
            <Border x:Name="border_usuarios" CornerRadius="8" Background="#FFFF6B6B" Height="36" Margin="0,0,0,8">
                <Button x:Name="button_usuarios" Content="Usuarios" Background="Transparent" BorderThickness="0" Foreground="White" Click="button_usuarios_Click"/>
            </Border>
        </StackPanel>
        <Border x:Name="border_guardar" CornerRadius="8" Background="#FF7FD05B" Margin="224,388,441,10">
            <Button x:Name="button_guardar" Content="Guardar" Background="Transparent" BorderThickness="0" Foreground="White" Click="button_guardar_Click"/>
        </Border>
        <Border x:Name="border_cancelar" CornerRadius="8" Background="#FFFF6B6B" Margin="627,388,38,10">
            <Button x:Name="button_cancelar" Content="Cancelar" Background="Transparent" BorderThickness="0" Foreground="White" Click="button_cancelar_Click"/>
        </Border>
        <TextBox x:Name="textbox_titulo" HorizontalAlignment="Left" Margin="224,108,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="247" Height="25"/>
        <Label x:Name="label_titulo" Content="Titulo" HorizontalAlignment="Left" Margin="224,82,0,0" VerticalAlignment="Top"/>
        <DatePicker x:Name="datepicker_fechaLanzamiento" HorizontalAlignment="Left" Margin="508,108,0,0" VerticalAlignment="Top" Width="254"/>
        <Label x:Name="label_fechaLanzamiento" Content="Fecha Lanzamiento" HorizontalAlignment="Left" Margin="508,82,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="textbox_estado" HorizontalAlignment="Left" Margin="224,180,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="247" Height="25"/>
        <Label x:Name="label_estado" Content="Estado" HorizontalAlignment="Left" Margin="224,154,0,0" VerticalAlignment="Top"/>
        <ComboBox x:Name="combobox_artista" HorizontalAlignment="Left" Margin="512,183,0,0" VerticalAlignment="Top" Width="247"/>
        <ComboBox x:Name="combobox_genero" HorizontalAlignment="Left" Margin="224,253,0,0" VerticalAlignment="Top" Width="251"/>
        <Label x:Name="label_artista" Content="Artista" HorizontalAlignment="Left" Margin="512,162,0,0" VerticalAlignment="Top"/>
        <Label x:Name="label_genero" Content="Genero" HorizontalAlignment="Left" Margin="224,227,0,0" VerticalAlignment="Top"/>

    </Grid>
</Window>
